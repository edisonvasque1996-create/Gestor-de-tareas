# ==============================================================================
# GESTOR ESTRATÉGICO DE TAREAS - VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y añade tus credenciales reales (NO subir .env a git)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de Firebase (Auth + Cloud Firestore)
# Obtén estos valores en: Firebase Console > Configuración del Proyecto > General
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_app_id

# ------------------------------------------------------------------------------
# 2. Configuración de AWS SES (Envío de Emails mediante Vercel Serverless Functions)
# Estas variables se configuran en el Dashboard de Vercel (Settings > Environment Variables)
# y NO se exponen al navegador cliente.
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=tu_aws_access_key_id
AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key
AWS_REGION=us-east-1
AWS_SES_SENDER_EMAIL=remitente_verificado@tudominio.com